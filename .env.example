# ---------------------------------------------------------------------------
# IOT // DASHBOARD - environment configuration
# Copy to `.env` and adjust. Every value below has a safe built-in default.
# ---------------------------------------------------------------------------

# HTTP / Socket.io
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# SQLite (file is created automatically, parent directories included)
DB_PATH=./data/iot.db

# MQTT broker
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=iot-dashboard-server
MQTT_TELEMETRY_TOPIC=iot/+/telemetry
MQTT_COMMAND_TOPIC_TEMPLATE=iot/{device_id}/command
MQTT_TELEMETRY_ENABLED=true

# Device liveness / heartbeat: a device is marked OFFLINE when no telemetry
# arrived within this many seconds. The dashboard applies the same rule to the
# device cards (see HEARTBEAT_MS in public/js/app.js) — keep the two in sync.
OFFLINE_AFTER_SECONDS=30
SWEEP_INTERVAL_SECONDS=15

# Telemetry retention (pruned hourly). 0 disables pruning.
TELEMETRY_RETENTION_DAYS=14
TELEMETRY_MAX_ROWS=2000000

# Demo seed: register this many demo devices on an empty database (0 = none).
SEED_DEVICE_COUNT=220

# Rate limiting for public webhook routes
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=600

# ---------------------------------------------------------------------------
# Upstream forwarding — mirror every ingested payload to the main website.
# Both values can also be set at runtime from the dashboard (Settings →
# Forwarding), where the stored value overrides these .env defaults.
# ---------------------------------------------------------------------------
MAIN_WEBSITE_WEBHOOK_URL=
MAIN_WEBSITE_FORWARD_ENABLED=false
FORWARD_TIMEOUT_MS=8000
FORWARD_RETRIES=2
FORWARD_CONCURRENCY=4
FORWARD_MAX_QUEUE=5000
FORWARD_RETRY_BACKOFF_MS=1500
